# Tutorly AI Environment Variables Example
# Copy this file to .env and add your keys (never commit your actual .env file)

# Google Gemini API Key (Gemini 2.5/3.6 Flash)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (gpt-4o-mini fallback)
VITE_OPENAI_API_KEY=your_openai_api_key_here
